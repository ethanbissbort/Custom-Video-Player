/* ---------------------------------------------------------------- Seek bar position */

/* Spoken seek-bar position, replacing the "47 percent" a bare slider would announce.
   %1$@ is the elapsed time and %2$@ the total duration, both already spelled out in words
   ("1 minute, 5 seconds"). */
"player.seekBar.value.accessibility" = "%1$@ of %2$@";

/* ---------------------------------------------------------------- Timecode fields */

/* The four timecode fields look identical to VoiceOver, so each names its own unit; the
   ":" separators and the "HH:MM:SS:FF" hint are visual only. */
"abloop.hours.accessibility" = "Hours";
"abloop.minutes.accessibility" = "Minutes";
"abloop.seconds.accessibility" = "Seconds";
"abloop.frames.accessibility" = "Frames";
