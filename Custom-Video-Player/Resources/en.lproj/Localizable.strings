/*
  Localizable.strings
  CustomVideoPlayer

  English (base) strings for the video player UI.

  Keys are namespaced by area: "player.*" for transport controls, "subtitles.*" and
  "quality.*" for the selection sheets, "abloop.*" for the A-B loop and segment playlist
  flows, and "error.*" for playback failure messages.

  Accessibility strings live alongside their visible counterparts with an
  ".accessibility" suffix, because a VoiceOver label often needs to be more explicit than
  the icon or abbreviation it describes.
*/

/* ---------------------------------------------------------------- Playback errors */

"error.title" = "Something went wrong. Please try again!";
"error.network" = "Please check your internet connection and try again.";
"error.playback" = "This video could not be played.";
"error.back" = "Back";

/* Shown when playback stops short of the end without reporting a load failure. */
"error.interrupted" = "Playback was interrupted. Please try again.";

/* ---------------------------------------------------------------- Transport controls */

"player.live" = "LIVE";
"player.abLoop" = "A-B";

"player.play.accessibility" = "Play";
"player.pause.accessibility" = "Pause";
"player.back.accessibility" = "Back";
"player.seekForward.accessibility" = "Skip forward 15 seconds";
"player.seekBackward.accessibility" = "Skip back 15 seconds";
"player.previousVideo.accessibility" = "Previous video";
"player.nextVideo.accessibility" = "Next video";
"player.subtitles.accessibility" = "Subtitles";
"player.settings.accessibility" = "Video quality";
"player.abLoop.accessibility" = "A-B loop";
"player.pictureInPicture.accessibility" = "Picture in Picture";
"player.airPlay.accessibility" = "AirPlay";
"player.seekBar.accessibility" = "Playback position";
"player.seekToLive.accessibility" = "Jump to live";

